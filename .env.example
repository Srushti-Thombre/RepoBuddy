# RepoBuddy Environment Configuration

# Gemini API Key for ADK Agents and LLM reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub API access token for checking repositories, issues, PRs, etc.
GITHUB_TOKEN=your_github_token_here

# Optional configuration: port for MCP HTTP server running on Server-Sent Events (SSE)
MCP_PORT=8000
