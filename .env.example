# RepoBuddy Environment Configuration

# Required: Gemini API Key for AI Reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model (defaults to gemini-2.5-flash for free tier compatibility)
GEMINI_MODEL=gemini-2.5-flash

# Optional: GitHub Token for higher rate limits (60 req/hr -> 5000 req/hr)
GITHUB_TOKEN=your_github_token_here

# Optional configuration: port for MCP HTTP server running on Server-Sent Events (SSE)
MCP_PORT=8000
